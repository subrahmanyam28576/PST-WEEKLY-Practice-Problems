
class Result {
    public static int marsExploration(String s) {
        int changedCount = 0;
        String target = "SOS";

        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) != target.charAt(i % 3)) {
                changedCount++;
            }
        }

        return changedCount;
    }
}
