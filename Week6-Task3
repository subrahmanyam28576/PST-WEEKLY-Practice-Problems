import java.util.*;

class Result {
    public static String twoStrings(String s1, String s2) {
        Set<Character> chars = new HashSet<>();
        for (char c : s1.toCharArray()) {
            chars.add(c);
        }
        for (char c : s2.toCharArray()) {
            if (chars.contains(c)) {
                return "YES";
            }
        }
        return "NO";
    }
}
